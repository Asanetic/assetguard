//======= create table in db

//=========== SYSTEM USERS TABLE
$system_users_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,
`name` varchar(255) NOT NULL,
`email` varchar(255),
`tel` varchar(50),
`login_password` varchar(255),
`ref_id` varchar(100),
`regdate` datetime,
`user_no` varchar(50),
`user_pic` varchar(255),
`user_gender` varchar(20),
`last_seen` datetime,
`about` text,
`hive_site_id` varchar(100),
`hive_site_name` varchar(255),
`auth_token` varchar(255),
`token_status` varchar(50),
`token_expiring_in` varchar(50),
`project_id` varchar(100),
`project_name` varchar(255),
`user_role` varchar(100)
";
$system_users_table = 'system_users';
create_table($mysqliconn, $dbname, $system_users_table, $system_users_table_script);

//=========== SYSTEM ROLE BUNDLES TABLE
$system_role_bundles_table_script = "
