//=========== SITES TABLE
$sites_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,
`site_name` varchar(255) NOT NULL,
`site_code` varchar(50),
`country` varchar(100),
`city` varchar(100),
`county` varchar(100),
`town` varchar(100),
`latitude` decimal(10,6),
`longitude` decimal(10,6),
`location_address` varchar(255),
`remark` varchar(255),
`created_on` datetime,
`manager` varchar(255),
`manager_mobile` varchar(50),
`manager_email` varchar(255),
`contact_person` varchar(255),
`contact_person_mobile` varchar(50),
`contact_person_email` varchar(255),
`company_security_manager` varchar(255),
`company_security_contacts` varchar(255),
`vendor_contact_person` varchar(255),
`vendor_contacts` varchar(255),
`response_team_contact_person` varchar(255),
`response_team_contacts` varchar(255),
`crew_commander_contact_person` varchar(255),
`crew_commander_contacts` varchar(255),
`vehicle_registration_number` varchar(50),
`alternate_phone_number` varchar(50),
`vendor` varchar(255),
`management_company` varchar(255),
`status` varchar(50) DEFAULT 'pending',
`region` varchar(100),
`smpms_vendor` varchar(255),
`security_company` varchar(255),
`response_cluster` varchar(255),
`assistant_1_name` varchar(255),
`assistant_1_contacts` varchar(255),
`assistant_2_name` varchar(255),
`assistant_2_contacts` varchar(255),
`country_manager_name` varchar(255),
`country_manager_contacts` varchar(255),
`regional_manager_name` varchar(255),
`regional_manager_contacts` varchar(255),
`response_contact_1_name` varchar(255),
`response_contact_1_contacts` varchar(255),
`response_contact_2_name` varchar(255),
`response_contact_2_contacts` varchar(255),
`response_contact_3_name` varchar(255),
`response_contact_3_contacts` varchar(255),
`noc_company` varchar(255),
`noc_contact_1_name` varchar(255),
`noc_contact_1_contacts` varchar(255),
`noc_contact_2_name` varchar(255),
`noc_contact_2_contacts` varchar(255),
`noc_contact_3_name` varchar(255),
`noc_contact_3_contacts` varchar(255),
`noc_contact_4_name` varchar(255),
`noc_contact_4_contacts` varchar(255),
`noc_contact_5_name` varchar(255),
`noc_contact_5_contacts` varchar(255),
`additional_sms_recipients` text,
`additional_email_recipients` text,
`last_inspection_date` datetime,
`created_at` datetime DEFAULT CURRENT_TIMESTAMP,
`updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
`hive_site_id` varchar(100),
`hive_site_name` varchar(255)
";
$sites_table = 'sites';
create_table($mysqliconn, $dbname, $sites_table, $sites_table_script);

//=========== DEVICE LIST TABLE
$device_list_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,
`device_name` varchar(255) NOT NULL,
`date_installed` datetime,
`serial_number` varchar(100),
`remark` varchar(255),
`registered_on` datetime,
`geofence` varchar(255),
`site_id` varchar(100),
`site_name` varchar(255),
`low_battery_level` varchar(20),
`geofence_limit_distance` varchar(50),
`device_location` varchar(255),
`speed_alert_value` varchar(50),
`device_type` varchar(100),
`status` varchar(50) DEFAULT 'offline',
`last_seen` datetime,
`created_at` datetime DEFAULT CURRENT_TIMESTAMP,
`updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
`hive_site_id` varchar(100),
`hive_site_name` varchar(255)
";
$device_list_table = 'device_list';
create_table($mysqliconn, $dbname, $device_list_table, $device_list_table_script);

