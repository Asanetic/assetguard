//=========== SMART MESSAGES TABLE
$smart_messages_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,
`message_number` varchar(100),
`related_record_id` varchar(100),
