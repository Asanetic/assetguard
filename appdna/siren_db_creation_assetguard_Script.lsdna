`bundle_id` varchar(100),
`bundle_name` varchar(255),
`remark` varchar(255),
`hive_site_id` varchar(100),
`hive_site_name` varchar(255)
";
$system_role_bundles_table = 'system_role_bundles';
create_table($mysqliconn, $dbname, $system_role_bundles_table, $system_role_bundles_table_script);

