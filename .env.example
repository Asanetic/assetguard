# Copy to .env.local and fill in real values.

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/assetguard
PGSSL=false
PG_POOL_MAX=10

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Email (Gmail / Google Workspace) for OTP ----
# IMPORTANT: authenticate as the REAL mailbox that owns the alias, and send
# FROM the alias. assetguard@symphony.co.ke is a "send mail as" alias of
# iotcom@symphony.co.ke, so EMAIL_USER is iotcom@..., EMAIL_FROM is the alias.
EMAIL_USER=iotcom@symphony.co.ke
EMAIL_PASS=your16charapppassword
EMAIL_FROM=Symphony AssetGuard <assetguard@symphony.co.ke>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ---- SMS (Asanetic) ----
SMS_API_URL=https://asanetic.com/sms/sendsms

# ---- OTP settings ----
OTP_TTL_MIN=10
# Set to "true" ONLY in local dev to return the code in the API response
# (lets you test without a real inbox/handset). NEVER true in production.
OTP_DEBUG=false
